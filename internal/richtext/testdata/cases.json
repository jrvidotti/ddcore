{
  "_comment": "Shared by internal/richtext/richtext_test.go and desk/src/lib/richtext.test.ts, so the server and the desk cannot drift apart on what a stored value means. Cases whose exact markup depends on the sanitizer's attribute order live under `contains`, not `normalize`.",
  "normalize": [
    { "name": "plain text becomes a paragraph", "in": "plain text", "out": "<p>plain text</p>" },
    { "name": "plain text keeps its angle brackets", "in": "a < b and b > c", "out": "<p>a &lt; b and b &gt; c</p>" },
    { "name": "a single newline is a break", "in": "one\ntwo", "out": "<p>one<br>two</p>" },
    { "name": "a blank line starts a paragraph", "in": "one\n\ntwo", "out": "<p>one</p><p>two</p>" },
    { "name": "markup is kept", "in": "<p>already <strong>markup</strong></p>", "out": "<p>already <strong>markup</strong></p>" },
    { "name": "a stripped block leaves a paragraph", "in": "<div onclick=\"alert(1)\">bare</div>", "out": "<p>bare</p>" },
    { "name": "headings survive", "in": "<h2>Title</h2><p>body</p>", "out": "<h2>Title</h2><p>body</p>" },
    { "name": "a continued list keeps its start", "in": "<ol start=\"3\"><li>three</li></ol>", "out": "<ol start=\"3\"><li>three</li></ol>" },
    { "name": "empty markup stays empty", "in": "<p></p>", "out": "<p></p>" }
  ],
  "contains": [
    { "name": "an external link opens a new tab", "in": "<a href=\"https://example.com\">out</a>", "present": ["href=\"https://example.com\"", "target=\"_blank\"", "noopener", "noreferrer", "nofollow"] },
    { "name": "a local image is kept", "in": "<img src=\"/files/a.png\" alt=\"A\">", "present": ["src=\"/files/a.png\"", "alt=\"A\""] }
  ],
  "text": [
    { "name": "paragraphs become lines", "in": "<p>one</p><p>two</p>", "out": "one\ntwo" },
    { "name": "a break becomes a line", "in": "<p>one<br>two</p>", "out": "one\ntwo" },
    { "name": "entities are decoded", "in": "<p>a &lt; b</p>", "out": "a < b" },
    { "name": "list items become lines", "in": "<ul><li>one</li><li>two</li></ul>", "out": "one\ntwo" },
    { "name": "a heading is a line of its own", "in": "<h2>T</h2><p>b</p>", "out": "T\nb" },
    { "name": "a link keeps only its text", "in": "<p>see <a href=\"/x\">this</a></p>", "out": "see this" }
  ],
  "strip": [
    { "name": "script", "in": "<script>alert(1)</script>", "absent": ["<script", "alert(1)"] },
    { "name": "event handler", "in": "<img src=x onerror=alert(1)>", "absent": ["onerror", "src="] },
    { "name": "javascript url", "in": "<a href=\"javascript:alert(1)\">click</a>", "absent": ["javascript:", "href="] },
    { "name": "data url", "in": "<a href=\"data:text/html;base64,PHN2Zz4=\">click</a>", "absent": ["data:", "href="] },
    { "name": "iframe", "in": "<iframe src=\"https://evil.example\"></iframe>", "absent": ["<iframe", "evil.example"] },
    { "name": "svg animation", "in": "<svg><animate onbegin=alert(1) attributeName=x dur=1s>", "absent": ["<svg", "onbegin"] },
    { "name": "inline style", "in": "<p style=\"position:fixed;top:0\">cover</p>", "absent": ["style="] },
    { "name": "form", "in": "<form action=\"https://evil.example\"><input name=\"pw\"></form>", "absent": ["<form", "<input"] },
    { "name": "remote image", "in": "<img src=\"https://evil.example/pixel.gif\">", "absent": ["evil.example", "src="] },
    { "name": "image path traversal", "in": "<img src=\"/files/../../etc/passwd\">", "absent": ["src="] },
    { "name": "mutation xss", "in": "<math><mtext><table><mglyph><style><img src=x onerror=alert(1)>", "absent": ["onerror", "<style"] }
  ]
}
